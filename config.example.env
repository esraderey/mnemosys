# MNEME v2.0.1 Configuration Example
# Copy this file to .env and adjust the values as needed

# === BASIC CONFIGURATION ===
MNEME_DEBUG=false
MNEME_LOG_LEVEL=INFO
MNEME_ENABLE_METRICS=true

# === PERFORMANCE CONFIGURATION ===
MNEME_MAX_WORKERS=4
MNEME_ENABLE_PARALLEL_PROCESSING=true
MNEME_CACHE_SIZE_MB=1024
MNEME_COMPRESSION_LEVEL=BALANCED

# === SECURITY CONFIGURATION ===
MNEME_SECURITY_LEVEL=SAFETENSORS
MNEME_ENABLE_ENCRYPTION=true
MNEME_ENABLE_MERKLE=true
MNEME_AUDIT_LOG_FILE=mneme_audit.log
MNEME_SECRET_KEY=your-secret-key-here-32-bytes-minimum

# === STORAGE CONFIGURATION ===
MNEME_STORAGE_BACKEND=HYBRID
MNEME_STORAGE_PATH=./mneme_storage
MNEME_CACHE_POLICY=ADAPTIVE
MNEME_ENABLE_DISTRIBUTED_CACHE=false

# === GPU CONFIGURATION ===
MNEME_USE_GPU=true
MNEME_GPU_MEMORY_FRACTION=0.8
MNEME_GPU_MEMORY_GROWTH=true
MNEME_MIXED_PRECISION=false

# === VALIDATION CONFIGURATION ===
MNEME_VALIDATE_INPUTS=true
MNEME_MAX_TENSOR_SIZE_MB=1024
MNEME_MAX_BATCH_SIZE=1000
MNEME_STRICT_VALIDATION=true

# === OPTIMIZATION CONFIGURATION ===
MNEME_ENABLE_LAZY_LOADING=true
MNEME_ENABLE_MEMORY_MAPPING=true
MNEME_ENABLE_ASYNC_OPERATIONS=true
MNEME_BATCH_PROCESSING_SIZE=100

# === MONITORING CONFIGURATION ===
MNEME_ENABLE_METRICS=true
MNEME_METRICS_INTERVAL=60.0
MNEME_ENABLE_PROFILING=false

# === REDIS CONFIGURATION (if using distributed cache) ===
MNEME_REDIS_URL=redis://localhost:6379/0
MNEME_REDIS_PASSWORD=
MNEME_REDIS_DB=0

# === CONTEXT DEDUPLICATION ===
MNEME_ENABLE_CONTEXT_DEDUPLICATION=true
MNEME_CONTEXT_SIMILARITY_THRESHOLD=0.8
MNEME_CONTEXT_CLUSTER_SIZE=10
MNEME_ENABLE_SEMANTIC_ANALYSIS=true

# === ADVANCED FEATURES ===
MNEME_ENABLE_SAFETENSORS=true
MNEME_ENABLE_LAZY_DECOMPRESSION=true
MNEME_ENABLE_GRANULAR_LOCKS=true
MNEME_ENABLE_ADAPTIVE_CACHE=true

# === DEVELOPMENT CONFIGURATION ===
MNEME_DEV_MODE=false
MNEME_ENABLE_DEBUG_LOGGING=false
MNEME_PROFILE_MEMORY=false
MNEME_ENABLE_BENCHMARKS=false

# === TESTING CONFIGURATION ===
MNEME_TEST_MODE=false
MNEME_TEST_CACHE_SIZE_MB=64
MNEME_TEST_MAX_WORKERS=2
