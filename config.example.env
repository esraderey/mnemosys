# MNEME v2.0 Configuration Example
# Copy this file to .env and adjust the values as needed

# Core Configuration
MNEME_CACHE_SIZE_MB=1024
MNEME_COMPRESSION_LEVEL=6
MNEME_ENABLE_ENCRYPTION=true
MNEME_ENABLE_COMPRESSION=true

# Security Configuration
MNEME_SECURITY_LEVEL=HIGH
MNEME_SECRET_KEY=your-secret-key-here
MNEME_AUDIT_LOG_FILE=mneme_audit.log

# Storage Configuration
MNEME_STORAGE_BACKEND=MEMORY
MNEME_STORAGE_PATH=./mneme_storage
MNEME_CACHE_POLICY=LRU
MNEME_CACHE_SIZE_MB=256

# Context Deduplication
MNEME_ENABLE_CONTEXT_DEDUPLICATION=true
MNEME_CONTEXT_SIMILARITY_THRESHOLD=0.8
MNEME_CONTEXT_CLUSTER_SIZE=10
MNEME_ENABLE_SEMANTIC_ANALYSIS=true

# Performance Configuration
MNEME_ENABLE_PARALLEL_PROCESSING=true
MNEME_MAX_WORKERS=4
MNEME_ENABLE_PROFILING=false

# Logging
MNEME_LOG_LEVEL=INFO
MNEME_LOG_FILE=mneme.log
MNEME_ENABLE_AUDIT_LOGGING=true

# Development
MNEME_DEBUG=false
MNEME_ENABLE_METRICS=true
MNEME_METRICS_INTERVAL_SECONDS=60

# Advanced Features
MNEME_ENABLE_SAFETENSORS=true
MNEME_ENABLE_LAZY_DECOMPRESSION=true
MNEME_ENABLE_GRANULAR_LOCKS=true
MNEME_ENABLE_ADAPTIVE_CACHE=true
